# Database
DATABASE_URL=

# Server
SERVER_PORT=3000

# Auth (JWT + cookies)
JWT_SECRET=change-me-to-a-secret-with-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ACCESS_COOKIE_NAME=fm_access_token
JWT_REFRESH_COOKIE_NAME=fm_refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS (app origin — required for credentials + cookies)
CORS_ORIGIN=http://localhost:5173

# Platform admin bootstrap (npm run seed:platform-admin only — not required for API boot)
PLATFORM_ADMIN_EMAIL=admin@farm-manager.local
PLATFORM_ADMIN_PASSWORD=ChangeMe1!x
PLATFORM_ADMIN_NAME=Platform Admin
