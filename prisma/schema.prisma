generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum PlatformRole {
  NONE
  PLATFORM_ADMIN
}

enum CropSeasonStatus {
  PLANNED
  ACTIVE
  CLOSED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farms               Farm[]
  memberships         Membership[]
  employees           Employee[]
  suppliers           Supplier[]
  costCenters         CostCenter[]
  accountPlans        AccountPlan[]
  unitsOfMeasurement  UnitOfMeasurement[]
  products            Product[]
  crops               Crop[]
  costCategories      CostCategory[]

  @@map("organizations")
}

model Farm {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  timezone       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id])
  memberships    Membership[]
  employees      Employee[]
  suppliers      Supplier[]
  products       Product[]
  transactions   Transaction[]
  stockMovements StockMovement[]
  stockBalances  ProductStockBalance[]
  fields         Field[]
  machines       Machine[]
  cropSeasons    CropSeason[]
  activities     Activity[]
  costEntries    CostEntry[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("farms")
}

model Membership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  farmId         String?
  role           Role     @default(USER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farm         Farm?        @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  password     String
  role         Role         @default(USER)
  platformRole PlatformRole @default(NONE)
  employeeId   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  employee      Employee?      @relation(fields: [employeeId], references: [id])
  refreshTokens RefreshToken[]
  memberships   Membership[]
  activities    Activity[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum EmployeeType {
  FARM_MANAGER
  AGRONOMIST
  VETERINARIAN
  MACHINE_OPERATOR
  FIELD_WORKER
  LIVESTOCK_HANDLER
  IRRIGATION_TECHNICIAN
  ADMINISTRATIVE_ASSISTANT
  DRIVER
  SECURITY_GUARD
  TEMPORARY_WORKER
  OTHER
}

model Employee {
  id             String       @id @default(uuid())
  organizationId String
  farmId         String?
  name           String
  registration   String
  type           EmployeeType
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  farm         Farm?        @relation(fields: [farmId], references: [id])

  users              User[]
  salaryTransactions SalaryTransaction[]
  activityLabor      ActivityLabor[]

  @@unique([organizationId, registration])
  @@index([organizationId])
  @@index([farmId])
  @@map("employees")
}

model Supplier {
  id             String   @id @default(uuid())
  organizationId String
  farmId         String?
  name           String
  cnpj           String
  address        String?
  phoneNumber    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  farm         Farm?        @relation(fields: [farmId], references: [id])

  purchaseTransactions PurchaseTransaction[]

  @@unique([organizationId, cnpj])
  @@index([organizationId])
  @@index([farmId])
  @@map("suppliers")
}

model CostCenter {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String
  code           String
  parentId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  transactionAllocation TransactionAllocation[]

  parent   CostCenter?  @relation("Children", fields: [parentId], references: [id])
  children CostCenter[] @relation("Children")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("cost_centers")
}

model AccountPlan {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String
  code           String
  parentId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  transactionAllocation TransactionAllocation[]

  parent   AccountPlan?  @relation("Children", fields: [parentId], references: [id])
  children AccountPlan[] @relation("Children")
  costCategories CostCategory[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("account_plans")
}

model CostCategory {
  id             String   @id @default(uuid())
  organizationId String
  code           String
  name           String
  parentId       String?
  accountPlanId  String?
  externalRef    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  accountPlan  AccountPlan? @relation(fields: [accountPlanId], references: [id])

  parent   CostCategory?  @relation("Children", fields: [parentId], references: [id])
  children CostCategory[] @relation("Children")
  costEntries CostEntry[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("cost_categories")
}

enum PaymentForm {
  CASH // Dinheiro
  CREDIT_CARD // Cartão de crédito
  DEBIT_CARD // Cartão de débito
  BANK_SLIP // Boleto bancário
  TRANSFER // Transferência bancária (ex: TED, DOC)
  PIX // Pagamento via PIX (Brasil)
  CHECK // Cheque
  DIGITAL_WALLET // Carteira digital (ex: PicPay, Mercado Pago)
  LOAN // Empréstimo interno ou externo
  TRADE // Permuta ou troca de produtos/serviços
  FINANCING // Financiamento (ex: BNDES, banco agrícola)
  OTHER // Outro
}

model Installment {
  id            String      @id @default(uuid())
  valueInCents  BigInt
  dueDate       DateTime
  paymentDate   DateTime?
  paymentForm   PaymentForm
  transactionId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@map("installments")
}

model TransactionAllocation {
  id                    String   @id @default(uuid())
  transactionId         String
  costCenterId          String
  accountPlanId         String
  allocatedValueInCents BigInt
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id])
  costCenter  CostCenter  @relation(fields: [costCenterId], references: [id])
  accountPlan AccountPlan @relation(fields: [accountPlanId], references: [id])

  @@map("transaction_allocations")
}

model UnitOfMeasurement {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  acronym        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization              Organization @relation(fields: [organizationId], references: [id])
  products                  Product[]
  cropsDefaultProduction    Crop[]       @relation("CropDefaultProductionUom")
  cropSeasonsProduction     CropSeason[] @relation("CropSeasonProductionUom")
  costEntries               CostEntry[]

  @@unique([organizationId, acronym])
  @@index([organizationId])
  @@map("unit_of_measurements")
}

model Product {
  id                  String   @id @default(uuid())
  organizationId      String
  farmId              String?
  name                String
  description         String?
  unitOfMeasurementId String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id])
  farm              Farm?             @relation(fields: [farmId], references: [id])
  unitOfMeasurement UnitOfMeasurement @relation(fields: [unitOfMeasurementId], references: [id])

  purchaseTransactionProducts PurchaseTransactionProduct[]
  stockMovements              StockMovement[]
  stockBalances               ProductStockBalance[]
  activityInputs              ActivityInput[]

  @@index([organizationId])
  @@index([farmId])
  @@map("products")
}

model PurchaseTransactionProduct {
  id                    String   @id @default(uuid())
  quantity              Decimal  @db.Decimal(18, 6)
  priceInCents          BigInt
  productId             String
  purchaseTransactionId String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  product             Product             @relation(fields: [productId], references: [id])
  PurchaseTransaction PurchaseTransaction @relation(fields: [purchaseTransactionId], references: [id])

  @@map("purchase_transaction_products")
}

model PurchaseTransaction {
  id            String   @id @default(uuid())
  documentRef   String?
  supplierId    String
  transactionId String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseTransactionProducts PurchaseTransactionProduct[]

  transaction Transaction @relation(fields: [transactionId], references: [id])
  supplier    Supplier    @relation(fields: [supplierId], references: [id])

  @@map("purchase_transactions")
}

model SalaryTransaction {
  id            String   @id @default(uuid())
  employeeId    String
  transactionId String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id])
  employee    Employee    @relation(fields: [employeeId], references: [id])

  @@map("salary_transactions")
}

enum GenericTransactionSubtype {
  GENERAL_EXPENSE
  FIXED_ASSET_EXPENSE
  LOAN_PAYMENT
  SERVICE_PAYMENT
  TAX_PAYMENT
  SUPPLIER_ADVANCE
  RENTAL_PAYMENT
  PROFIT_DISTRIBUTION
  INSURANCE_EXPENSE
  LOSS_OR_FINE
  PROJECT_INVESTMENT
  BANK_FEE
  OTHER
}

model GenericTransactionDetails {
  id            String                    @id @default(uuid())
  transactionId String                    @unique
  subtype       GenericTransactionSubtype
  note          String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@map("generic_transaction_details")
}

enum TransactionType {
  PURCHASE_INPUT
  SALARY_PAYMENT
  GENERIC
}

model Transaction {
  id        String          @id @default(uuid())
  farmId    String
  type      TransactionType
  date      DateTime        @default(now())
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  farm Farm @relation(fields: [farmId], references: [id])

  installments           Installment[]
  transactionAllocations TransactionAllocation[]

  purchaseTransaction PurchaseTransaction?
  salaryTransaction   SalaryTransaction?
  genericDetails      GenericTransactionDetails?
  stockMovements      StockMovement[]

  @@index([farmId])
  @@map("transactions")
}

enum StockMovementType {
  IN // entrada: compras
  OUT // saída: via atividade (futuro)
  ADJUSTMENT // ajustes manuais
}

enum StockMovementSourceType {
  PURCHASE
  ACTIVITY
  ADJUSTMENT
}

model StockMovement {
  id            String                   @id @default(uuid())
  farmId        String
  type          StockMovementType
  productId     String
  date          DateTime                 @default(now())
  quantity      Decimal                  @db.Decimal(18, 6)
  note          String?
  transactionId String?
  sourceType    StockMovementSourceType?
  sourceId      String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  farm        Farm         @relation(fields: [farmId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([farmId])
  @@index([productId])
  @@map("stock_movements")
}

model ProductStockBalance {
  id             String   @id @default(uuid())
  farmId         String
  productId      String
  quantityOnHand Decimal  @default(0) @db.Decimal(18, 6)
  avgCost        Decimal  @default(0) @db.Decimal(18, 8)
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  farm    Farm    @relation(fields: [farmId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([farmId, productId])
  @@index([farmId])
  @@map("product_stock_balances")
}

model Field {
  id           String   @id @default(uuid())
  farmId       String
  name         String
  areaHa       Decimal  @db.Decimal(18, 6)
  active       Boolean  @default(true)
  plantsPerHa  Decimal? @db.Decimal(18, 6)
  plantedYear  Int?
  spacingNote  String?
  externalRef  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  farm        Farm           @relation(fields: [farmId], references: [id])
  plantings   CropPlanting[]
  activities  Activity[]
  costEntries CostEntry[]

  @@unique([farmId, name])
  @@index([farmId])
  @@map("fields")
}

model Crop {
  id                      String   @id @default(uuid())
  organizationId          String
  name                    String
  defaultProductionUomId  String?
  externalRef             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization         Organization @relation(fields: [organizationId], references: [id])
  defaultProductionUom UnitOfMeasurement? @relation("CropDefaultProductionUom", fields: [defaultProductionUomId], references: [id])
  varieties            Variety[]
  cropSeasons          CropSeason[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("crops")
}

model Variety {
  id          String   @id @default(uuid())
  cropId      String
  name        String
  externalRef String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  crop      Crop           @relation(fields: [cropId], references: [id])
  plantings CropPlanting[]

  @@unique([cropId, name])
  @@index([cropId])
  @@map("varieties")
}

model CropSeason {
  id                          String           @id @default(uuid())
  farmId                      String
  cropId                      String
  name                        String
  startDate                   DateTime
  endDate                     DateTime?
  status                      CropSeasonStatus @default(PLANNED)
  productionUomId             String
  referenceSalePriceInCents   BigInt?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  farm          Farm             @relation(fields: [farmId], references: [id])
  crop          Crop             @relation(fields: [cropId], references: [id])
  productionUom UnitOfMeasurement @relation("CropSeasonProductionUom", fields: [productionUomId], references: [id])
  plantings     CropPlanting[]
  activities    Activity[]
  costEntries   CostEntry[]

  @@index([farmId])
  @@index([cropId])
  @@map("crop_seasons")
}

model CropPlanting {
  id            String   @id @default(uuid())
  cropSeasonId  String
  fieldId       String
  varietyId     String?
  plantedAreaHa Decimal? @db.Decimal(18, 6)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cropSeason CropSeason @relation(fields: [cropSeasonId], references: [id], onDelete: Cascade)
  field      Field      @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  variety    Variety?   @relation(fields: [varietyId], references: [id], onDelete: SetNull)

  @@unique([cropSeasonId, fieldId])
  @@index([cropSeasonId])
  @@index([fieldId])
  @@map("crop_plantings")
}

model Machine {
  id                        String   @id @default(uuid())
  farmId                    String
  name                      String
  hourlyCostInCents         BigInt
  fuelIncludedInHourlyCost  Boolean  @default(true)
  active                    Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  farm              Farm                  @relation(fields: [farmId], references: [id])
  activityMachineHours ActivityMachineHour[]

  @@unique([farmId, name])
  @@index([farmId])
  @@map("machines")
}

enum LaborPayBasis {
  HOUR
  DAY
  OUTPUT
}

enum ActivityType {
  PREPARATION
  FERTILIZATION
  PHYTOSANITARY
  IRRIGATION
  MANAGEMENT
  HARVEST
  OTHER
}

enum CostEntrySourceType {
  ACTIVITY_INPUT
  ACTIVITY_LABOR
  ACTIVITY_MACHINE
  ALLOCATION
  REVERSAL
}

model Activity {
  id              String       @id @default(uuid())
  farmId          String
  cropSeasonId    String
  fieldId         String
  activityType    ActivityType
  date            DateTime
  note            String?
  createdByUserId String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  farm        Farm            @relation(fields: [farmId], references: [id])
  cropSeason  CropSeason      @relation(fields: [cropSeasonId], references: [id])
  field       Field           @relation(fields: [fieldId], references: [id])
  createdBy     User                  @relation(fields: [createdByUserId], references: [id])
  inputs        ActivityInput[]
  labor         ActivityLabor[]
  machineHours  ActivityMachineHour[]
  costEntries   CostEntry[]

  @@index([farmId])
  @@index([cropSeasonId, date])
  @@map("activities")
}

model ActivityInput {
  id               String   @id @default(uuid())
  activityId       String
  productId        String
  quantity         Decimal  @db.Decimal(18, 6)
  unitCostSnapshot Decimal  @db.Decimal(18, 8)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([activityId])
  @@map("activity_inputs")
}

model ActivityLabor {
  id             String        @id @default(uuid())
  activityId     String
  employeeId     String?
  contractorName String?
  payBasis       LaborPayBasis
  hours          Decimal?      @db.Decimal(18, 6)
  days           Decimal?      @db.Decimal(18, 6)
  outputQty      Decimal?      @db.Decimal(18, 6)
  costInCents    BigInt
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  activity Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([activityId])
  @@map("activity_labor")
}

model ActivityMachineHour {
  id                  String   @id @default(uuid())
  activityId          String
  machineId           String
  hours               Decimal  @db.Decimal(18, 6)
  hourlyCostSnapshot  BigInt
  costInCents         BigInt
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  machine  Machine  @relation(fields: [machineId], references: [id])

  @@index([activityId])
  @@map("activity_machine_hours")
}

model CostEntry {
  id             String              @id @default(uuid())
  farmId         String
  cropSeasonId   String
  fieldId        String?
  activityId     String?
  sourceType     CostEntrySourceType
  sourceId       String
  costCategoryId String
  amountInCents  BigInt
  quantity       Decimal?            @db.Decimal(18, 6)
  uomId          String?
  date           DateTime
  reversedAt     DateTime?
  reversalOfId   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  farm         Farm               @relation(fields: [farmId], references: [id])
  cropSeason   CropSeason         @relation(fields: [cropSeasonId], references: [id])
  field        Field?             @relation(fields: [fieldId], references: [id])
  activity     Activity?          @relation(fields: [activityId], references: [id])
  costCategory CostCategory       @relation(fields: [costCategoryId], references: [id])
  uom          UnitOfMeasurement? @relation(fields: [uomId], references: [id])
  reversalOf   CostEntry?         @relation("CostEntryReversal", fields: [reversalOfId], references: [id])
  reversals    CostEntry[]        @relation("CostEntryReversal")

  @@index([cropSeasonId])
  @@index([farmId, date])
  @@index([sourceType, sourceId])
  @@map("cost_entries")
}
