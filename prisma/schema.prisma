generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  role       Role     @default(USER)
  employeeId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee      Employee?      @relation(fields: [employeeId], references: [id])
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum EmployeeType {
  FARM_MANAGER
  AGRONOMIST
  VETERINARIAN
  MACHINE_OPERATOR
  FIELD_WORKER
  LIVESTOCK_HANDLER
  IRRIGATION_TECHNICIAN
  ADMINISTRATIVE_ASSISTANT
  DRIVER
  SECURITY_GUARD
  TEMPORARY_WORKER
  OTHER
}

model Employee {
  id           String       @id @default(uuid())
  name         String
  registration String       @unique
  type         EmployeeType
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users              User[]
  salaryTransactions SalaryTransaction[]

  @@map("employees")
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  cnpj        String   @unique
  address     String?
  phoneNumber String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseTransactions PurchaseTransaction[]

  @@map("suppliers")
}

model CostCenter {
  id          String   @id @default(uuid())
  name        String
  description String
  code        String   @unique
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactionAllocation TransactionAllocation[]

  parent   CostCenter?  @relation("Children", fields: [parentId], references: [id])
  children CostCenter[] @relation("Children")

  @@map("cost_centers")
}

model AccountPlan {
  id          String   @id @default(uuid())
  name        String
  description String
  code        String   @unique
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactionAllocation TransactionAllocation[]

  parent   AccountPlan?  @relation("Children", fields: [parentId], references: [id])
  children AccountPlan[] @relation("Children")

  @@map("account_plans")
}

enum PaymentForm {
  CASH // Dinheiro
  CREDIT_CARD // Cartão de crédito
  DEBIT_CARD // Cartão de débito
  BANK_SLIP // Boleto bancário
  TRANSFER // Transferência bancária (ex: TED, DOC)
  PIX // Pagamento via PIX (Brasil)
  CHECK // Cheque
  DIGITAL_WALLET // Carteira digital (ex: PicPay, Mercado Pago)
  LOAN // Empréstimo interno ou externo
  TRADE // Permuta ou troca de produtos/serviços
  FINANCING // Financiamento (ex: BNDES, banco agrícola)
  OTHER // Outro
}

model Installment {
  id            String      @id @default(uuid())
  valueInCents  BigInt
  dueDate       DateTime
  paymentDate   DateTime?
  paymentForm   PaymentForm
  transactionId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@map("installments")
}

model TransactionAllocation {
  id                    String   @id @default(uuid())
  transactionId         String
  costCenterId          String
  accountPlanId         String
  allocatedValueInCents BigInt
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id])
  costCenter  CostCenter  @relation(fields: [costCenterId], references: [id])
  accountPlan AccountPlan @relation(fields: [accountPlanId], references: [id])

  @@map("transaction_allocations")
}

model UnitOfMeasurement {
  id        String   @id @default(uuid())
  name      String
  acronym   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("unit_of_measurements")
}

model Product {
  id                  String   @id @default(uuid())
  name                String
  description         String?
  unitOfMeasurementId String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  unitOfMeasurement           UnitOfMeasurement            @relation(fields: [unitOfMeasurementId], references: [id])
  purchaseTransactionProducts PurchaseTransactionProduct[]
  stockMovements              StockMovement[]
  stockBalance                ProductStockBalance?

  @@map("products")
}

model PurchaseTransactionProduct {
  id                    String   @id @default(uuid())
  quantity              Decimal  @db.Decimal(18, 6)
  priceInCents          BigInt
  productId             String
  purchaseTransactionId String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  product             Product             @relation(fields: [productId], references: [id])
  PurchaseTransaction PurchaseTransaction @relation(fields: [purchaseTransactionId], references: [id])

  @@map("purchase_transaction_products")
}

model PurchaseTransaction {
  id            String   @id @default(uuid())
  documentRef   String?
  supplierId    String
  transactionId String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseTransactionProducts PurchaseTransactionProduct[]

  transaction Transaction @relation(fields: [transactionId], references: [id])
  supplier    Supplier    @relation(fields: [supplierId], references: [id])

  @@map("purchase_transactions")
}

model SalaryTransaction {
  id            String   @id @default(uuid())
  employeeId    String
  transactionId String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id])
  employee    Employee    @relation(fields: [employeeId], references: [id])

  @@map("salary_transactions")
}

enum GenericTransactionSubtype {
  GENERAL_EXPENSE
  FIXED_ASSET_EXPENSE
  LOAN_PAYMENT
  SERVICE_PAYMENT
  TAX_PAYMENT
  SUPPLIER_ADVANCE
  RENTAL_PAYMENT
  PROFIT_DISTRIBUTION
  INSURANCE_EXPENSE
  LOSS_OR_FINE
  PROJECT_INVESTMENT
  BANK_FEE
  OTHER
}

model GenericTransactionDetails {
  id            String                    @id @default(uuid())
  transactionId String                    @unique
  subtype       GenericTransactionSubtype
  note          String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@map("generic_transaction_details")
}

enum TransactionType {
  PURCHASE_INPUT
  SALARY_PAYMENT
  GENERIC
}

model Transaction {
  id        String          @id @default(uuid())
  type      TransactionType
  date      DateTime        @default(now())
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  installments           Installment[]
  transactionAllocations TransactionAllocation[]

  purchaseTransaction PurchaseTransaction?
  salaryTransaction   SalaryTransaction?
  genericDetails      GenericTransactionDetails?
  stockMovements      StockMovement[]

  @@map("transactions")
}

enum StockMovementType {
  IN // entrada: compras
  OUT // saída: via atividade (futuro)
  ADJUSTMENT // ajustes manuais
}

enum StockMovementSourceType {
  PURCHASE
  ACTIVITY
  ADJUSTMENT
}

model StockMovement {
  id            String                   @id @default(uuid())
  type          StockMovementType
  productId     String
  date          DateTime                 @default(now())
  quantity      Decimal                  @db.Decimal(18, 6)
  note          String?
  transactionId String?
  sourceType    StockMovementSourceType?
  sourceId      String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  product     Product      @relation(fields: [productId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@map("stock_movements")
}

// PR-03: PK composta (farmId, productId) quando Farm existir (ADR-012).
model ProductStockBalance {
  id             String   @id @default(uuid())
  productId      String   @unique
  quantityOnHand Decimal  @default(0) @db.Decimal(18, 6)
  avgCost        Decimal  @default(0) @db.Decimal(18, 8)
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@map("product_stock_balances")
}
